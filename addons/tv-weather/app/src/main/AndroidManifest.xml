<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Only to ask Open-Meteo for the weather at the place in strings.xml; nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false">

        <!-- Clean Your TV launcher, weather: where Home reads the current conditions. -->
        <meta-data android:name="com.gathin.tvhome.weather" android:value="app.tvweather.now" />

        <!-- Read-only: a temperature, a condition and the place name, which Home shows anyway. -->
        <provider
            android:name=".NowProvider"
            android:authorities="app.tvweather.now"
            android:exported="true" />
    </application>
</manifest>
